# Copy to .env and chmod 600. Prefer: hermes-relay init
# Never commit a real .env.

# Required for `hermes-relay serve`. Not a Bearer token.
HERMES_RELAY_OWNER_SECRET=replace-with-output-of-hermes-relay-init

# Public HTTPS origin advertised in OAuth discovery (no trailing slash, no /mcp).
# Set this after Cloudflare Tunnel / Caddy is serving TLS.
HERMES_RELAY_PUBLIC_BASE_URL=https://your-tunnel.example

# Optional persistent HMAC key for access/refresh tokens.
# If unset, a key is derived and tokens become invalid on restart.
# HERMES_RELAY_TOKEN_KEY=

HERMES_RELAY_BIND_HOST=127.0.0.1
HERMES_RELAY_BIND_PORT=8099

# HERMES_BIN=/usr/local/bin/hermes
# HERMES_HOME=

# chat_oneshot (default) or top_level_z
HERMES_RELAY_INVOKE_MODE=chat_oneshot

HERMES_RELAY_SYNC_TIMEOUT=180
HERMES_RELAY_ASYNC_TIMEOUT=600
HERMES_RELAY_MAX_CONCURRENT=2
HERMES_RELAY_MAX_QUEUE=8
HERMES_RELAY_JOB_TTL=3600
HERMES_RELAY_MAX_ANSWER_CHARS=32000
HERMES_RELAY_MAX_TURNS_DEFAULT=16
HERMES_RELAY_MAX_TURNS_CAP=64

# Extra Host / Origin allowlist entries (comma-separated) if your tunnel hostname
# differs from PUBLIC_BASE_URL.
# HERMES_RELAY_ALLOWED_HOSTS=
# HERMES_RELAY_ALLOWED_ORIGINS=
